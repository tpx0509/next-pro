// Prisma schema —— Day 3 用它替换 data/likes.json
// 文档：https://pris.ly/d/prisma-schema

// v7 的默认 generator 叫 prisma-client（老的 prisma-client-js 已废弃）。
// 它生成的是纯 TypeScript 源码，必须显式指定 output，不再往 node_modules 里塞东西。
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// v7 的 datasource 里【不写 url】了，连接串挪到 prisma7.config.ts 的 datasource.url。
datasource db {
  provider = "sqlite"
}

/// 博客文章。原先硬编码在 src/app/blog/posts.ts 里的三篇，现在搬到这里。
/// slug 当主键：文章的 URL 就是 /blog/<slug>，天然唯一、且永远按它查。
/// 注意 body 目前是纯文本一段话；将来写长文可以换成 Markdown 原文。
model Post {
  slug  String @id
  title String
  body  String

  /// 手工排序位，越小越靠前。
  /// 不能用 createdAt 代替：批量导入时几篇的创建时间是同一毫秒，
  /// 数据库无法给出稳定顺序（实测：三篇 createdAt 完全相同 → 退化成主键字母序）。
  position Int @default(0)
  likeCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 下面四张表是毕业项目（AI 知识库问答）的骨架，目前只建结构、还没有页面在用。
// 关系形状：User 1—N Document、User 1—N Conversation、Conversation 1—N Message。
// 外键列不会自动建索引，所以每张表的「高频查询列」都显式挂了 @@index。

/// 用户。
model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String?

  /// 密码哈希（bcrypt，自带 salt）。库里绝不放明文，也不放可逆加密。
  /// bcrypt 的串长固定 60 字符，但留 String 默认长度即可。
  passwordHash String

  // 反向字段：库里不存在这一列，只是让 user.documents 这种写法有类型。
  documents     Document[]
  conversations Conversation[]
  sessions      Session[]
  createdAt     DateTime     @default(now())
}

/// 登录会话。
/// 为什么不用固定 cookie 值（原来那个 session=ok）：那种写法任何人手写一个同名
/// cookie 就登录了。session token 是 32 字节随机数，猜不出来；删掉这行就等于
/// 立刻吊销（这是 DB session 比无状态 JWT 好的地方：JWT 发出去就撤不回）。
model Session {
  /// token 本身就是凭证，直接当主键：查它 = 查主键，天然带索引。
  token  String @id
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 过期时间由应用层判断。惰性清理：读的时候校验，顺手删过期的。
  expiresAt DateTime
  createdAt DateTime @default(now())

  /// 外键不自动建索引，而「列出某人的所有会话 / 退出全部设备」要按 userId 查。
  @@index([userId])
}

/// 知识库文档。content 先整段存，做 RAG 时再拆出 chunk 表。
model Document {
  id      Int    @id @default(autoincrement())
  title   String
  content String

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// 一次问答会话。
/// 用自增 id 而不是 slug：会话没有天然唯一字段，标题用户还能随便改。
model Conversation {
  id    Int     @id @default(autoincrement())
  title String?

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// 会话里的一条消息。
/// role 用 String 不用 enum：SQLite 的 enum 落地只是 TEXT，数据库层不校验，
/// 约束交给 TypeScript 的联合类型（'user' | 'assistant'）更诚实。
model Message {
  id      Int    @id @default(autoincrement())
  role    String
  content String

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
}
