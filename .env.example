# 复制成 .env 后即可使用（.env 本身被 .gitignore 排除，不会进版本库）
# 路径基准是项目根，所以写成 ./prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"

# --- 流式问答用的上游模型（OpenAI 兼容接口）---
# 代码读的是 LLM_* 优先、退化到 OPENAI_*，所以系统里已经有 OPENAI_API_KEY
# 的话这两行可以省掉。换供应商只改 base url 和模型名。
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY="sk-..."
# CHAT_MODEL="gpt-6.1-sol"
