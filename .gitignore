# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 例外：模板文件必须提交，否则别人 clone 下来不知道要配什么
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local runtime data (likes), changes on every click — replaced by DB on day 3
/data/likes.json

/src/generated/prisma

# 本地 SQLite 库文件（每台机器自己 migrate 出来，不进版本库）
/prisma/dev.db
/prisma/dev.db-journal

# prisma init 自动下载的 AI agent 技能包，和本项目代码无关
/.agents/
/.claude/
/skills-lock.json
